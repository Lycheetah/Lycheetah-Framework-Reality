{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIM v1.2 Evidence-Preservation Packet",
  "type": "object",
  "required": [
    "experiment_id",
    "source_artifacts",
    "fields",
    "expressions",
    "required_semantic_names",
    "calculation_requirements",
    "human_review"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "media_type", "sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "description": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_id", "semantic_name", "raw_text", "normalized_value",
          "unit", "source_id", "state"
        ],
        "properties": {
          "field_id": {"type": "string", "minLength": 1},
          "semantic_name": {"type": "string", "minLength": 1},
          "raw_text": {"type": ["string", "null"]},
          "normalized_value": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]},
          "source_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["OBSERVED", "UNKNOWN"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"const": "UNKNOWN"}}},
            "then": {"properties": {"normalized_value": {"const": null}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "expression_id", "source_id", "raw_expression", "left_value",
          "raw_operator", "right_value", "printed_outcome",
          "canonical_operator", "canonical_scope"
        ],
        "properties": {
          "expression_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "raw_expression": {"type": "string", "minLength": 1},
          "left_value": {"type": "number"},
          "raw_operator": {"enum": ["<", "<=", "≤", ">", ">=", "≥", "=", "==", "!=", "≠"]},
          "right_value": {"type": "number"},
          "printed_outcome": {"enum": ["PASS", "FAIL", null]},
          "canonical_operator": {"enum": ["<", "<=", "≤", ">", ">=", "≥", "=", "==", "!=", "≠", null]},
          "canonical_scope": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "required_semantic_names": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "calculation_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"},
        "uniqueItems": true
      }
    },
    "entropy_closure": {
      "type": ["object", "null"],
      "properties": {
        "declared_total": {"type": ["number", "null"]},
        "components": {"type": "array", "items": {"type": ["number", "null"]}},
        "relative_tolerance": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": ["required", "status"],
      "properties": {
        "required": {"const": true},
        "status": {"enum": ["pending", "approved", "rejected", "revised"]},
        "reviewer": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
