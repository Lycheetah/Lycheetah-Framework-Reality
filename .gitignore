# Runtime residue and local tooling — do not stage generated state.
# Source, manifests, evidence files, and shipped fixtures remain tracked.

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Provenance checker local SQLite ledger (written beside the script by
# demo / fingerprint / check when using the default DB_PATH). Override by
# pointing init_db() at another path from library callers; delete the file
# to clean: rm components/provenance-checker/provenance_ledger.db
provenance_ledger.db
*.db
*.sqlite
*.sqlite3

# Test / coverage / type caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/

# Local environments
.venv/
venv/
env/
ENV/

# Editor / OS debris
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
